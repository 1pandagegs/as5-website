# Resend (https://resend.com) API key used to send contact-form
# submissions. Without a real key, submissions are validated and logged
# server-side but not emailed — except when NODE_ENV/VERCEL_ENV is
# "production", where the endpoint returns 503 so the visitor is told to
# email or call instead of seeing a false "received" message.
RESEND_API_KEY=TODO_replace_with_real_resend_api_key

# Address that receives contact-form inquiries (defaults to info@as5group.com).
INQUIRY_RECIPIENT_EMAIL=info@as5group.com

# Sender address. Its domain (as5group.com) must be verified in Resend,
# otherwise every send is rejected.
INQUIRY_FROM_EMAIL=AS5 Group Website <website@as5group.com>

# Port the server listens on (optional, defaults to 4000).
PORT=4000
